  "orthographe": [
    {
      "regle": "Écriture phonétique",
      "detail": "Chaque lettre se prononce ; pas de lettre muette."
    },
    {
      "regle": "U = OU",
      "detail": "mutu se lit moutou ; yipunu se lit yipounou."
    },
    {
      "regle": "Semi-voyelle W",
      "detail": "Devant a, e, i : u devient souvent w (mwane = enfant)."
    },
    {
      "regle": "Tons",
      "detail": "Accents possibles pour distinguer le sens des mots."
    },
    {
      "regle": "Classes nominales",
      "detail": "Le préfixe change au pluriel : mutu/batu, ikole/bikole, disu/misu."
    },
    {
      "regle": "Infinitif des verbes",
      "detail": "Préfixe U : u vose (parler), u be (être), u ne (avoir). Dans le lexique, - remplace u."
    },
    {
      "regle": "Emprunts",
      "detail": "pitali (hôpital), dibuku (livre), fure (franc), magasi (magasin)."
    }
